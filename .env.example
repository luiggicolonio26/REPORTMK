# --- the model that writes the report: set exactly ONE key ---------------

# Groq — free, no card, no phone. https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Mistral — free tier, needs phone verification. https://console.mistral.ai
# MISTRAL_API_KEY=...

# Anthropic — paid (~$0.04 a report), and the only one that can look the
# weather up by web search. https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Only needed if more than one key above is set, or to override the model.
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# --- optional -------------------------------------------------------------

# Shared history across computers. Set by the Vercel Upstash integration.
# KV_REST_API_URL=https://....upstash.io
# KV_REST_API_TOKEN=...

# Strongly recommended on a public URL: without it, anyone who finds the
# address can use your API allowance.
# APP_PASSWORD=choose-something-long
