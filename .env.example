# Required — the report and the weather-search fallback run through the server,
# so this key never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — shared history across computers. Both naming schemes work; the
# Vercel Marketplace Upstash integration sets them for you.
# KV_REST_API_URL=https://....upstash.io
# KV_REST_API_TOKEN=...

# Optional but strongly recommended on a public URL: without it, anyone who
# finds the address can spend your Anthropic credit.
# APP_PASSWORD=choose-something-long
